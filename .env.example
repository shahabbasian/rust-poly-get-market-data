# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/polymarket

# Gamma API base URL
GAMMA_API_URL=https://gamma-api.polymarket.com

# How often to run the full scan (seconds)
SCAN_INTERVAL_SECS=120

# How far ahead to look for upcoming markets (hours)
LOOKAHEAD_HOURS_5M=6
LOOKAHEAD_HOURS_15M=12
LOOKAHEAD_HOURS_1H=24
LOOKAHEAD_HOURS_4H=72

# API request delay (milliseconds)
API_DELAY_MS=150

# Phase 2: WebSocket reconnection delay (seconds)
WS_RECONNECT_DELAY_SECS=5

# Phase 2: How often to refresh market states (seconds)
LIFECYCLE_INTERVAL_SECS=5

# Phase 2: Subscribe to markets starting within this many seconds
WATCH_AHEAD_SECS=60

# Phase 2: Channel buffer size for DB write batching
ORDERBOOK_BUFFER_SIZE=10000

# Phase 2: Max events per batch INSERT
BATCH_INSERT_SIZE=500

# Phase 2: Max wait before flushing batch to DB (milliseconds)
BATCH_FLUSH_INTERVAL_MS=500

# Phase 2: Interval for polling Gamma API for market resolutions (seconds)
RESOLUTION_POLL_INTERVAL_SECS=60

# Log level
RUST_LOG=info,polymarket_scanner=debug
