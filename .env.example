# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/polymarket

# Gamma API base URL
GAMMA_API_URL=https://gamma-api.polymarket.com

# How often to run the full scan (seconds)
SCAN_INTERVAL_SECS=120

# How far ahead to look for upcoming markets (hours)
LOOKAHEAD_HOURS_5M=6
LOOKAHEAD_HOURS_15M=12
LOOKAHEAD_HOURS_1H=24
LOOKAHEAD_HOURS_4H=72

# API request delay (milliseconds)
API_DELAY_MS=150

# --- Phase 2: collector / price_sampler ---

# CLOB market WebSocket host (channel path /ws/market is appended automatically)
WS_MARKET_HOST=wss://ws-subscriptions-clob.polymarket.com

# RTDS host
RTDS_HOST=wss://ws-live-data.polymarket.com

# Scheduler poll interval (ms)
SCHEDULER_POLL_MS=1000

# Subscribe N seconds before start_date
SUBSCRIBE_LEAD_SECS=5

# Batch writer flush interval (ms) and per-table row cap
BATCH_FLUSH_MS=250
BATCH_MAX_ROWS=1000

# RTDS tick must be within ±N seconds of start_date before falling back
STRIKE_WINDOW_SECS=2

# Defensive teardown grace period after end_date
TEARDOWN_GRACE_SECS=30

# Price sampler poll interval (ms) and pre-load lead time
SAMPLER_POLL_MS=1000
SAMPLER_LEAD_SECS=5

# Log level
RUST_LOG=info,polymarket_scanner=debug,polymarket_client_sdk_v2=info
